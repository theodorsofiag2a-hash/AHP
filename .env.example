# Copie para .env.local e preencha com os valores reais (nunca commitar .env.local).

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — nunca expor ao client. Usado para operações privilegiadas (ex: concessão manual de créditos).
SUPABASE_SERVICE_ROLE_KEY=

# E-mails da equipe G2A autorizados a conceder créditos manualmente (separados por vírgula).
PLATFORM_ADMIN_EMAILS=voce@g2a.com.br

# Asaas (cobrança). Tudo server-only, exceto NEXT_PUBLIC_APP_URL.
# "sandbox" usa api-sandbox.asaas.com + chave $aact_hmlg_…; "production" usa api.asaas.com + chave $aact_prod_….
# Trocar de ambiente exige trocar URL e chave juntas (a chave de um ambiente dá 401 no outro).
ASAAS_ENV=sandbox
# ATENÇÃO: a chave começa com "$", e o Next expande "$VAR" em arquivos .env (sem escape ela carrega VAZIA;
# aspas simples NÃO protegem). Em .env.local escreva ASAAS_API_KEY=\$aact_hmlg_… . No painel da Vercel, cole sem escape.
ASAAS_API_KEY=
# Token do webhook (32 a 255 caracteres, diferente da chave de API). O Asaas o envia no header asaas-access-token.
ASAAS_WEBHOOK_TOKEN=
# Domínio fixo de produção, usado em webhook e callbacks de pagamento (sem barra final).
NEXT_PUBLIC_APP_URL=https://ahp-pi-three.vercel.app
# Interruptor das telas/ações de compra. Só "true" liga; qualquer outro valor deixa desligado.
BILLING_ENABLED=false
# Opcional: slugs das organizações-piloto (separados por vírgula). Com BILLING_ENABLED=true e esta lista preenchida,
# só elas veem e usam a compra. Vazio = todas.
BILLING_PILOT_ORGS=
